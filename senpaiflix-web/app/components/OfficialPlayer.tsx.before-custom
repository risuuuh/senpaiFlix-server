"use client";

import { useEffect, useState } from "react";

type PlayerProps = {
  title: string;
  embedUrl?: string;
  watchUrl?: string;
};

type Episode = {
  animeTitle: string;
  episodeNumber: number;
  title: string;
  videoUrl?: string;
  embedUrl?: string;
  watchUrl?: string;
};

function getYouTubeEmbedUrl(raw: string): string | null {
  try {
    const url = new URL(raw.trim());
    let id = "";

    if (url.hostname === "youtu.be") {
      id = url.pathname.split("/").filter(Boolean)[0] ?? "";
    } else if (
      ["youtube.com", "www.youtube.com", "m.youtube.com"].includes(
        url.hostname
      )
    ) {
      if (url.pathname === "/watch") {
        id = url.searchParams.get("v") ?? "";
      } else if (
        url.pathname.startsWith("/embed/") ||
        url.pathname.startsWith("/shorts/")
      ) {
        id = url.pathname.split("/")[2] ?? "";
      }
    }

    if (!/^[a-zA-Z0-9_-]{11}$/.test(id)) return null;

    return `https://www.youtube-nocookie.com/embed/${id}`;
  } catch {
    return null;
  }
}

function getSafeWatchUrl(raw?: string): string {
  if (!raw) return "";

  try {
    const url = new URL(raw.trim());
    return url.protocol === "https:" ? url.href : "";
  } catch {
    return "";
  }
}

function getPlayableUrl(raw?: string): string {
  if (!raw) return "";

  const youtubeUrl = getYouTubeEmbedUrl(raw);
  if (youtubeUrl) return youtubeUrl;

  try {
    const url = new URL(raw.trim());

    if (url.protocol !== "https:") return "";

    if (
      ["youtube.com", "www.youtube.com", "www.youtube-nocookie.com"].includes(
        url.hostname
      ) &&
      /^\/embed\/[A-Za-z0-9_-]+$/.test(url.pathname)
    ) {
      return url.href;
    }

    if (
      url.hostname === "player.vimeo.com" &&
      /^\/video\/[0-9]+$/.test(url.pathname)
    ) {
      return url.href;
    }

    return "";
  } catch {
    return "";
  }
}

export default function OfficialPlayer({
  title,
  embedUrl,
  watchUrl,
}: PlayerProps) {
  const [episodes, setEpisodes] = useState<Episode[]>([]);
  const [selected, setSelected] = useState("");
  const [activeUrl, setActiveUrl] = useState(
    getPlayableUrl(embedUrl)
  );
  const [activeWatchUrl, setActiveWatchUrl] = useState(watchUrl ?? "");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function loadEpisodes() {
      setLoading(true);
      setError("");
      setEpisodes([]);
      setSelected("");
      setActiveUrl(getPlayableUrl(embedUrl));
      setActiveWatchUrl(watchUrl ?? "");

      try {
        const response = await fetch(
          `/api/episodes?title=${encodeURIComponent(title)}`,
          { cache: "no-store" }
        );

        if (!response.ok) {
          throw new Error("Episode catalogue request failed.");
        }

        const data = (await response.json()) as {
          episodes?: Episode[];
        };

        if (!cancelled) {
          setEpisodes(data.episodes ?? []);
        }
      } catch {
        if (!cancelled) {
          setError("Episode list load nahi ho saki. Server check karo.");
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    loadEpisodes();

    return () => {
      cancelled = true;
    };
  }, [title, embedUrl, watchUrl]);

  function playEpisode(episode: Episode) {
    const url = getPlayableUrl(episode.embedUrl || episode.videoUrl);
    const externalUrl = getSafeWatchUrl(
      episode.watchUrl || episode.videoUrl
    );

    if (!url && !externalUrl) {
      setError("Is episode ke liye valid HTTPS viewing source configured nahi hai.");
      return;
    }

    setActiveUrl(url);
    setActiveWatchUrl(externalUrl);
    setSelected(`${episode.episodeNumber}:${episode.title}`);
    setError("");
  }

  return (
    <section className="mt-6 w-full space-y-4">
      <div className="flex items-center gap-2 text-xs text-white/60">
        Official viewing options
      </div>

      <div className="relative aspect-video w-full overflow-hidden rounded-2xl border border-white/10 bg-black">
        {activeUrl ? (
          <iframe
            key={activeUrl}
            src={activeUrl}
            title={`${title} video player`}
            className="absolute inset-0 h-full w-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerPolicy="strict-origin-when-cross-origin"
            allowFullScreen
          />
        ) : (
          <div className="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
            <p className="text-base font-semibold text-white">{title}</p>
            <p className="max-w-sm text-xs leading-6 text-white/50">
              Abhi is anime ke liye koi playable, authorized source configure
              nahi hai. Neeche available episodes check karo.
            </p>
          </div>
        )}
      </div>

      <div className="space-y-3">
        <h3 className="text-sm font-semibold text-white">Episodes</h3>

        {loading ? (
          <p className="text-sm text-white/50">Loading episodes...</p>
        ) : episodes.length === 0 ? (
          <p className="text-sm text-white/50">
            Abhi episodes configured nahi hain. data/episodes.json mein
            authorized source add karna hoga.
          </p>
        ) : (
          <div className="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {episodes
              .slice()
              .sort((a, b) => a.episodeNumber - b.episodeNumber)
              .map((episode) => {
                const key = `${episode.episodeNumber}:${episode.title}`;

                return (
                  <button
                    key={key}
                    type="button"
                    onClick={() => playEpisode(episode)}
                    className={`rounded-xl border px-4 py-3 text-left text-sm transition ${
                      selected === key
                        ? "border-white bg-white text-black"
                        : "border-white/10 bg-white/5 text-white hover:bg-white/10"
                    }`}
                  >
                    <span className="block font-medium">
                      Episode {episode.episodeNumber}
                    </span>
                    <span className="mt-1 block opacity-70">
                      {episode.title}
                    </span>
                  </button>
                );
              })}
          </div>
        )}
      </div>

      {error && <p className="text-sm text-red-400">{error}</p>}

      {activeWatchUrl && (
        <a
          href={activeWatchUrl}
          target="_blank"
          rel="noopener noreferrer"
          className="inline-block text-sm text-white/70 underline"
        >
          Watch on official source
        </a>
      )}

      <p className="text-xs text-white/50">
        Playback depends on the source allowing external embedding. Use only
        content you are authorized to embed.
      </p>
    </section>
  );
}
